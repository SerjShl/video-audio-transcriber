# Keep the build context small and reproducible.
.git
.github
.idea
.venv
venv
**/__pycache__
*.pyc
*.egg-info
.pytest_cache
.ruff_cache

# JS deps and prior build output are regenerated inside the image.
**/node_modules
frontend/dist
frontend/*.tsbuildinfo

# Runtime data and secrets never belong in an image.
data
.env
cookies.txt
img.png

# Not needed at runtime.
tests
