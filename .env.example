# Transcription engine: groq (cloud API, default) or local (offline faster-whisper).
# TRANSCRIBER_ENGINE=groq

# --- groq engine (cloud) ---
# Groq API key (free, fast Whisper).
# Get one here: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Groq Whisper model (default whisper-large-v3-turbo).
# WHISPER_MODEL=whisper-large-v3-turbo

# --- local engine (offline faster-whisper) ---
# Only used when TRANSCRIBER_ENGINE=local. No API key, no upload limit,
# nothing leaves your machine. Install with: pip install ".[local]"
# The model is downloaded once and cached, then runs fully offline.
# WHISPER_LOCAL_MODEL=large-v3          # tiny | base | small | medium | large-v3 | large-v3-turbo
# WHISPER_DEVICE=auto                   # auto | cpu | cuda
# WHISPER_COMPUTE_TYPE=default          # default | int8 | float16 | ...

# Browser to read cookies from (optional).
# Uncomment if YouTube asks you to "Sign in to confirm you're not a bot".
# Possible values: chrome, edge, firefox, brave, opera, vivaldi
# YT_DLP_BROWSER=chrome

# Path to a Netscape-format cookies.txt (takes precedence over YT_DLP_BROWSER).
# YT_DLP_COOKIES=./cookies.txt

# How many files to process in parallel in scan mode (default 3).
# SCAN_CONCURRENCY=3

# Keep the downloaded audio after transcription (same as the --keep flag).
# KEEP_AUDIO=true

# Web server port (default 8000).
# PORT=8000
