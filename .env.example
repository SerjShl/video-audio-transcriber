# Groq API Key (бесплатный, быстрый Whisper)
# Получить можно здесь: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Браузер для cookies (опционально).
# Раскомментируйте, если YouTube требует "Sign in to confirm you're not a bot".
# Возможные значения: chrome, edge, firefox, brave, opera, vivaldi
# YT_DLP_BROWSER=chrome

# Сколько файлов обрабатывать параллельно в режиме scan (по умолчанию 3).
# SCAN_CONCURRENCY=3

# Не удалять скачанное аудио после транскрибации (то же, что флаг --keep).
# KEEP_AUDIO=true