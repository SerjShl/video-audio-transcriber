# Local-only tool. The Groq API key is normally entered in the app (Settings),
# not here. Everything below is optional.

# --- Local engine (offline faster-whisper) ---
# WHISPER_LOCAL_MODEL=large-v3-turbo   # tiny | base | small | medium | large-v3 | large-v3-turbo
# WHISPER_DEVICE=cpu                   # cpu | cuda | auto  (cpu works everywhere)
# WHISPER_COMPUTE_TYPE=int8            # default | int8 | float16 | ...

# --- Groq (cloud) engine ---
# The key is set in the app Settings; this env var is only a fallback.
# GROQ_API_KEY=gsk_...
# WHISPER_MODEL=whisper-large-v3-turbo

# --- yt-dlp (YouTube) ---
# The web UI uploads a cookies.txt in Settings. For the CLI you can point at one:
# YT_DLP_COOKIES=./cookies.txt
# YT_DLP_BROWSER=chrome                # chrome | edge | firefox | brave | ...

# How many files to process in parallel in scan mode (default 3).
# SCAN_CONCURRENCY=3

# Web server port / bind host (defaults 8000 / 127.0.0.1).
# PORT=8000
# HOST=127.0.0.1
