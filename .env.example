# Transcription engine: groq (cloud API, default) or local (offline whisper.cpp).
# TRANSCRIBER_ENGINE=groq

# --- groq engine (cloud) ---
# Groq API key (free, fast Whisper).
# Get one here: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- local engine (offline whisper.cpp) ---
# Only needed when TRANSCRIBER_ENGINE=local. No API key, no upload limit,
# nothing leaves your machine.
# WHISPER_CPP_BIN=whisper-cli
# WHISPER_CPP_MODEL=models/ggml-large-v3-turbo.bin

# Browser to read cookies from (optional).
# Uncomment if YouTube asks you to "Sign in to confirm you're not a bot".
# Possible values: chrome, edge, firefox, brave, opera, vivaldi
# YT_DLP_BROWSER=chrome

# How many files to process in parallel in scan mode (default 3).
# SCAN_CONCURRENCY=3

# Keep the downloaded audio after transcription (same as the --keep flag).
# KEEP_AUDIO=true
